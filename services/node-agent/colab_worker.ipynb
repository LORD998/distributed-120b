      "source": [
        "# 🤖 Nó Voluntário: IA Distribuída 120B (Google Colab)\n",
        "Este script transforma esta máquina virtual gratuita do Google num "Nó de Inferência" para a sua rede descentralizada.\n",
        "\n",
        "**Como usar:**\n",
        "1. Vá na sua Interface Web e crie um **Token** de voluntário.\n",
        "2. Copie a URL pública do seu API Gateway (ex: `https://api.seu-projeto.workers.dev`).\n",
        "3. Rode a célula abaixo e preencha com as suas informações."
      ],
      "metadata": {
        "id": "header-cell"
      }
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "setup-cell"
      },
      "outputs": [],
      "source": [
        "# 1. Instala as dependências necessárias\n",
        "!pip install fastapi uvicorn requests pyngrok -q\n",
        "\n",
        "import os\n",
        "import time\n",
        "import requests\n",
        "import threading\n",
        "import json\n",
        "from pyngrok import ngrok\n",
        "import uvicorn\n",
        "from fastapi import FastAPI, Request\n",
        "from fastapi.responses import StreamingResponse\n",
        "import asyncio\n",
        "\n",
        "# ==========================================\n",
        "# 🔧 CONFIGURAÇÃO DO SEU NÓ\n",
        "# ==========================================\n",
        "API_GATEWAY_URL = input(\"Digite a URL do seu Gateway Cloudflare (ex: http://xxxx): \")\n",
        "TOKEN = input(\"Digite o seu Token gerado na Interface Web: \")\n",
        "NGROK_AUTH_TOKEN = input(\"Digite o seu Authtoken do Ngrok (opcional, p/ não cair a conexão): \")\n",
        "\n",
        "if NGROK_AUTH_TOKEN:\n",
        "    ngrok.set_auth_token(NGROK_AUTH_TOKEN)\n",
        "\n",
        "# ==========================================\n",
        "# 🚀 SERVIDOR DE INFERÊNCIA LOCAL (vLLM Mock)\n",
        "# ==========================================\n",
        "app = FastAPI()\n",
        "\n",
        "@app.post(\"/generate\")\n",
        "async def generate(request: Request):\n",
        "    body = await request.json()\n",
        "    message = body.get(\"message\", \"\")\n",
        "    \n",
        "    async def vllm_simulator():\n",
        "        words = [\" [\", \"Respondido\", \" por\", \" uma\", \" GPU\", \" T4\", \" do\", \" Google\", \" Colab!]\\n\\n\", \"Recebi:\", f\" '{message}'\"]\n",
        "        for word in words:\n",
        "            await asyncio.sleep(0.1)\n",
        "            yield f\"data: {json.dumps({'text': word})}\\n\\n\"\n",
        "        yield f\"data: {json.dumps({'done': True})}\\n\\n\"\n",
        "\n",
        "    return StreamingResponse(vllm_simulator(), media_type=\"text/event-stream\")\n",
        "\n",
        "def run_server():\n",
        "    uvicorn.run(app, host=\"0.0.0.0\", port=8080)\n",
        "\n",
        "# Inicia o servidor em background\n",
        "threading.Thread(target=run_server, daemon=True).start()\n",
        "time.sleep(3) # Aguarda o servidor subir\n",
        "\n",
        "# ==========================================\n",
        "# 🌍 EXPOR PARA A INTERNET E AVISAR A REDE\n",
        "# ==========================================\n",
        "public_url = ngrok.connect(8080).public_url\n",
        "print(f\"\\n✅ Túnel criado! A GPU do Colab está exposta em: {public_url}\")\n",
        "\n",
        "print(\"\\n🔄 Enviando Heartbeat para a sua rede...\")\n",
        "headers = {\"Authorization\": f\"Bearer {TOKEN}\"}\n",
        "payload = {\n",
        "    \"node_id\": \"colab-gpu-001\",\n",
        "    \"region\": \"google-cloud\",\n",
        "    \"vram_gb\": 16,\n",
        "    \"gpu_model\": \"Tesla T4\",\n",
        "    \"status\": \"online\",\n",
        "    \"endpoint\": public_url\n",
        "}\n",
        "\n",
        "try:\n",
        "    res = requests.post(f\"{API_GATEWAY_URL}/v1/heartbeat\", json=payload, headers=headers)\n",
        "    if res.status_code == 200:\n",
        "        print(\"🎉 SUCESSO! Esta GPU T4 acaba de se juntar à sua rede 120B.\")\n",
        "        print(\"Volte para o seu site e você verá o Colab acender verde na lista de Voluntários!\")\n",
        "    else:\n",
        "        print(f\"❌ Erro de Autenticação na Rede: {res.text}\")\n",
        "except Exception as e:\n",
        "    print(f\"❌ Erro ao contactar o Gateway: {e}\")\n",
        "\n",
        "print(\"\\nMantenha esta aba aberta para a placa de vídeo continuar ligada à rede.\")\n"
      ]
    }
  ]
}
